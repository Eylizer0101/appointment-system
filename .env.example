# Set these in Render > Web Service > Environment (never commit your real .env)
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/appointment_system
SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
NODE_ENV=production
# Required only if password-reset emails are used
NODEMAILER_PASSWORD=REPLACE_WITH_EMAIL_APP_PASSWORD
