<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Banda ni Shaho</title>
    
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@100;200;300;400;500;600;700;800&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css">
    
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels"></script>
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="/responsive.css">
    <link rel="icon" href="/images/logo.png">

    <style>
    </style>
</head>
<body id="app" class="abstractBG justifyEnd padding80 gap10">

    <video autoplay muted loop playsinline class="absolute width70 borderPrimary borderRadius30 glowImg2" style="opacity: 0.05; left: 15%; z-index: 0; top: 60px;">
        <source src="/images/video.mp4" type="video/mp4">
        Your browser does not support the video tag.
    </video>

    <video autoplay muted loop playsinline class="absolute width16 borderRadius15 glowImg" style="display: none; opacity: 1; left: 7%; z-index: 5; top: 42%;">
        <source src="/images/video.mp4" type="video/mp4">
        Your browser does not support the video tag.
    </video>

    <div class="height0 width65 absolute left10 top100 padding10">
        <p class="size100 str400 absolute left100 top20 gradientText upperCase"> &nbsp; Banda &nbsp;</p>
        <p class="size80 str400 absolute left100 top100 gradientText"> &nbsp;ni Shaho &nbsp;</p>
        <img src="/images/gem.png" alt="" class="w500 glowImg2" style="transform: rotate(10deg); margin-top: 40px;">
    </div>
    
    

    <div class="height0 width30 bgWhite padding10 borderRadius20 darkShadow relative marginRight100">
        <form class="" @submit.prevent="adminLogin">
            <div class="gap20 col relative padding5">
                <div class="height0 col">
                    <p class="title">Welcome Admin</p>
                    <p v-if="errorMessage" class="error" style="color:red;">{{ errorMessage }}</p>
                    <div id="server-error" class="height0 error str600 borderRadius5 textCenter" style="display:flex;"></div>
                </div>
                <div class="col gap10 width100">
                    <div class="field width100">
                        <label for="username">Username</label>
                        <input type="text" id="username" name="username" v-model="username" required>
                    </div>
                    <div class="field password width100">
                        <label for="password">Password</label>
                        <input :type="showPassword ? 'text' : 'password'" id="password" name="password" v-model="password" required>
                        <span class="showPass faded"
                            @click="showPassword = !showPassword">
                            {{ showPassword ? 'hide' : 'show' }}
                        </span>
                    </div>
                </div>
        
                <button type="submit" class="nav width100 size14 str400 abstractBG" id="loginBtn">Log in</button>
                <a href="/forgot" id="frgBtn">Forgot Password</a>
            </div>
        </form>
        <a href="/" class="nav cnav absolute top20 left20"><i class="fas fa-chevron-left"></i></a>
    </div>

    <!-- Vue scripts -->
    <script>

        const app = Vue.createApp({

            data() {
                return {
                    username: '',
                    password: '',
                    errorMessage: '',
                    showPassword: false,
                }
            },

            methods: {
                async adminLogin() {
                    try {
                        const res = await fetch('/login', {
                            method: 'POST',
                            headers: {'Content-Type': 'application/json'},
                            body: JSON.stringify({
                                username: this.username,
                                password: this.password
                            })
                        });

                        const data = await res.json();

                        if (!res.ok) {
                            this.errorMessage = data.error;
                            return;
                        }

                        window.location.href = data.redirectPath;

                    } catch (err) {
                        this.errorMessage = "An error occurred.";
                        console.log(err);
                    }
                }
            },

            async mounted() {
                try {
                    const res = await fetch('/session-check');
                    if (!res.ok) return;
                    const data = await res.json();
                    if (data.loggedIn) {
                        window.location.href = data.redirectPath;
                    }
                } catch (err) {
                    console.error('Session check failed:', err);
                }
            },

        })

        app.mount('#app');

    </script>
    
</body>
</html>
