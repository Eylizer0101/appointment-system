<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Create Appointment Manager | Banda ni Shaho</title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap">
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    html { min-height: 100%; }
    body { margin: 0; min-height: 100vh; background: linear-gradient(135deg,#180900 0%,#46210b 55%,#935013 100%); color:#2f1a0c; font-family:Poppins,Arial,sans-serif; padding:30px 16px; }
    .shell { max-width: 630px; margin: 0 auto; }
    .topline { display:flex; align-items:center; justify-content:space-between; gap:16px; margin-bottom:22px; }
    .brand { color:#ffe1a5; font-size:19px; font-weight:700; }
    .back { color:#fff1d5; text-decoration:none; border:1px solid #b88850; padding:10px 15px; border-radius:12px; font-size:13px; }
    .card { background:#fffdf9; padding:clamp(22px,5vw,38px); border-radius:22px; box-shadow:0 20px 55px #0005; }
    h1 { margin:0 0 9px; font-size:clamp(24px,4vw,30px); line-height:1.25; color:#49240d; }
    .description { margin:0 0 24px; color:#6a5a4e; font-size:14px; line-height:1.6; }
    .field-row { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16px; }
    .field { min-width:0; margin-bottom:16px; }
    label { display:block; font-size:13px; font-weight:600; margin-bottom:7px; }
    input { display:block; width:100%; min-width:0; font:inherit; font-size:15px; border:1px solid #c6b9ac; border-radius:10px; padding:12px 14px; background:#fff; color:#2f1a0c; }
    input:focus-visible { outline:2px solid #b4782a; outline-offset:1px; }
    .hint { font-size:12px; color:#77675b; margin-top:6px; }
    .alert { padding:12px 14px; border-radius:10px; margin-bottom:18px; font-size:13px; line-height:1.5; }
    .alert-error { background:#fff0eb; border:1px solid #e9a796; color:#872f1e; }
    .alert-success { background:#eef9ef; border:1px solid #8ac596; color:#245b32; }
    .submit { display:block; width:100%; margin-top:12px; background:linear-gradient(100deg,#6c360f,#c9852c); color:white; border:0; border-radius:12px; font:600 15px Poppins,sans-serif; padding:15px; cursor:pointer; }
    .submit:hover { filter:brightness(1.08); }
    .notice { margin:18px 0 0; font-size:12px; line-height:1.6; color:#766151; }
    @media(max-width:520px) { body {padding:18px 12px;} .card {padding:22px 18px;} .field-row {grid-template-columns:1fr;gap:0;} .brand {font-size:16px;} }
  </style>
</head>
<body>
  <main class="shell">
    <div class="topline">
      <div class="brand">Banda ni Shaho</div>
      <a class="back" href="/dsb">Back to Dashboard</a>
    </div>
    <section class="card">
      <h1>Create Appointment Manager</h1>
      <p class="description">Private account creation for existing administrators only. This account uses the system's existing admin access level.</p>
      <% if (error) { %><p class="alert alert-error" role="alert"><%= error %></p><% } %>
      <% if (success) { %><p class="alert alert-success" role="status"><%= success %></p><% } %>
      <form action="/staff/register" method="POST" autocomplete="off">
        <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
        <div class="field-row">
          <div class="field"><label for="firstName">First Name</label><input id="firstName" name="firstName" maxlength="80" value="<%= values.firstName || '' %>" required autocomplete="given-name"></div>
          <div class="field"><label for="lastName">Last Name</label><input id="lastName" name="lastName" maxlength="80" value="<%= values.lastName || '' %>" required autocomplete="family-name"></div>
        </div>
        <div class="field"><label for="username">Username</label><input id="username" name="username" maxlength="40" minlength="3" pattern="[A-Za-z0-9._-]{3,40}" value="<%= values.username || '' %>" required autocomplete="off"><div class="hint">3–40 characters: letters, numbers, dots, underscores or hyphens</div></div>
        <div class="field"><label for="email">Email</label><input type="email" id="email" name="email" maxlength="200" value="<%= values.email || '' %>" required autocomplete="off"></div>
        <div class="field-row">
          <div class="field"><label for="password">Password</label><input type="password" id="password" name="password" minlength="10" maxlength="128" required autocomplete="new-password"></div>
          <div class="field"><label for="confirmPassword">Confirm Password</label><input type="password" id="confirmPassword" name="confirmPassword" minlength="10" maxlength="128" required autocomplete="new-password"></div>
        </div>
        <button class="submit" type="submit">Create Account</button>
      </form>
      <p class="notice">No public registration button is displayed. To create another account, return to this page while signed in as an administrator.</p>
    </section>
  </main>
</body>
</html>
