<% layout('layout') %>
<head>
    <style>
        #dd {
            display: none !important;
            opacity: 0 !important;
        }
.showPass {
    position: absolute;
    right: 10px;
    bottom: 12px;
    cursor: pointer;
}
        .disabled-link {
            opacity: 0.5;
            pointer-events: none; /* disables the click */
            cursor: not-allowed;
        }
        button:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
    </style>
</head>
<body>

  <div id="app">

    <div class="absolute top0 left0 bgModal padding30 index60" id="updateCard">

      <div class="height0 padding30 width35 borderRadius15 relative bgWhite"  id="updateFormCard">
        <a href="javascript:history.back()" class="nav cnav absolute top10 right10 index50" id="updateX"><i class="fas fa-xmark"></i></a>

        <form @submit.prevent="updateProfile" class="padding5 gap10">
          <input type="hidden" name="id" value="<%= user._id %>">

          <div class="field">
            <p class="size30 str500">Update Details</p>
          </div>

          <div class="height0 gap10">
            <div class="field">
              <label>First Name</label>
              <input type="text" v-model="firstName" @input="sanitizeField('firstName')" required>
            </div>
            <div class="field">
              <label>Middle Name</label>
              <input type="text" v-model="middleName" @input="sanitizeField('middleName')">
            </div>
          </div>

          <div class="height0 gap10">
            <div class="field">
              <label>Last Name</label>
              <input type="text" v-model="lastName" @input="sanitizeField('lastName')" required>
            </div>
            <div class="field">
              <label>Ext Name</label>
              <input type="text" v-model="extName" @input="sanitizeField('extName')">
            </div>
          </div>
          
          <div class="field">
              <label>Email</label>
              <input type="text" v-model="email" @blur="validateEmail" required>
          </div>

          <div class="field">
              <label>Phone</label>
              <input type="text" v-model="phone" @input="validatePhone" required>
          </div>

          <div class="field">
              <label>Address</label>
              <input type="text" v-model="address" @input="sanitizeField('address')" required>
          </div>
          
          <div class="field">
              <label>Username</label>
              <input type="text" v-model="newUsername" @input="validateUsername" required>
          </div>

          <div class="field password">
              <label>Current Password</label>
              <input :type="showPassword ? 'text' : 'password'" v-model="password" required>
                        <span class="showPass faded"
                            @click="showPassword = !showPassword">
                            {{ showPassword ? 'hide' : 'show' }}
                        </span>
          </div>

          <p v-if="emailError" style="color:red">{{ emailError }}</p>
          <p v-if="errorMessage" style="color:red">{{ errorMessage }}</p>

          <div class="height0 justifyEnd padding5">
            <button type="submit" :disabled="invalidEmail" class="nav pnav">Save Changes</button>
          </div>
        </form>
      </div>

      
      <div class="height0 padding40 width25 borderRadius20 relative bgWhite col hidden" id="successCard">
        <i class="fas fa-check-circle green size80"></i>
        <br>
        <p class="size20 str500 textCenter">You updated your information successfully!</p>
        <br>
        <div class="height0 justifyEnd padding5 gap10">
          <button class="nav border0 width100" onclick="location.href='/dsb'">Got It!</button>
        </div>
      </div>

    </div>

  </div>

